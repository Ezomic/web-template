APP_NAME="Web Template"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://web-template.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Error reporting to flare. Off by default: a fresh clone has no project
# registered in flare yet, and enabling it without a key would have every clone
# firing at the ingest endpoint with nothing to accept it. Register the app in
# flare, put its key here, then flip FLARE_ENABLED to true and confirm with
# `php artisan flare:test`. The X-Request-Id that request-id stamps on every
# request, job and command is what lets a snag report be traced to the
# exception behind it, and that works whether or not flare is enabled.
FLARE_ENABLED=false
FLARE_URL=https://flare.thijssensoftware.nl
FLARE_KEY=

# Workflow mode: delegate auth to Thijssensoftware ID (SSO) and show the portal
# switcher. Leave WORKFLOW_MODE=false for a standalone app. When true, register
# the app with `php artisan id:app` on the ID server and fill in the client keys.
WORKFLOW_MODE=false
THIJSSENSOFTWARE_ID_URL=https://id.thijssensoftware.nl
THIJSSENSOFTWARE_ID_CLIENT_ID=
THIJSSENSOFTWARE_ID_CLIENT_SECRET=
THIJSSENSOFTWARE_ID_APP_SLUG=
THIJSSENSOFTWARE_ID_PORTAL_TTL=300
